CARD_GATEWAY_BASE_URL=http://host.docker.internal:8072
CARD_GATEWAY_API_KEY=bank-key-uk-a
CARD_GATEWAY_HMAC_SECRET=secret-uk-a-hmac

# UK Payment Systems (CHAPS / FPS / BACS) — external uk-payment-systems project.
UKPS_CHAPS_URL=http://host.docker.internal:8420
UKPS_FPS_URL=http://host.docker.internal:8421
UKPS_BACS_URL=http://host.docker.internal:8422
# This bank's own identity. With UKPS_AUTO_REGISTER=True the bank registers
# itself in each scheme on first use and persists the returned API key, so the
# per-scheme keys are blank. To reuse a pre-seeded BIC instead, set its key(s)
# and UKPS_AUTO_REGISTER=False (e.g. SNDRUK22 + ak_sndruk22_dev).
UKPS_BANK_BIC=LYOBGB2L
UKPS_BANK_NAME=Lyo Bank
UKPS_BANK_SORT_CODE=10-20-30
UKPS_BANK_SU_CODE=SU-LYOB
UKPS_CHAPS_API_KEY=
UKPS_FPS_API_KEY=
UKPS_BACS_API_KEY=
UKPS_AUTO_REGISTER=True
# FPS events carry no destination account, so inbound FPS funds land here.
UKPS_INBOUND_FALLBACK_ACCOUNT=
